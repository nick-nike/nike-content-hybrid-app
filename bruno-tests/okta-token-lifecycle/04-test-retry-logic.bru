meta {
  name: 04 - Test Retry Logic
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/token/test-retry
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "maxAttempts": 3,
    "retryDelaySeconds": 10,
    "forceFailure": true,
    "timeoutMinutes": 2
  }
}

vars:pre-request {
  retryTestStartTime: {{$timestamp}}
}

script:pre-request {
  bru.setVar("retryTestStartTime", Date.now());
  
  console.log("❌ 开始测试重试逻辑");
  console.log("📋 测试参数:");
  console.log("  - 最大重试次数: 3次");
  console.log("  - 重试间隔: 10秒");
  console.log("  - 强制失败: 是");
  console.log("  - 超时时间: 2分钟");
  
  // 根据前一个测试的结果调整策略
  const refreshTestSuccess = bru.getVar("refreshTestSuccess");
  const failureEventsCount = bru.getVar("failureEventsCount") || 0;
  
  if (refreshTestSuccess && failureEventsCount === 0) {
    console.log("🔄 前一次刷新成功，将强制模拟失败场景");
    // 保持forceFailure: true
  } else if (failureEventsCount > 0) {
    console.log("🔄 检测到之前有失败事件，可能已经在重试中");
    // 可以观察现有的重试逻辑
    req.setBody(JSON.stringify({
      maxAttempts: 3,
      retryDelaySeconds: 10,
      forceFailure: false, // 不强制失败，观察现有状态
      timeoutMinutes: 2
    }));
  }
}

script:post-response {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response should have retry test results", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('attempts');
    expect(body).to.have.property('retryResults');
  });
  
  const result = res.getBody();
  const testDuration = Date.now() - bru.getVar("retryTestStartTime");
  
  console.log("📊 重试逻辑测试结果:");
  console.log("  - 测试完成:", result.success ? "✅ 是" : "❌ 否");
  console.log("  - 重试次数:", result.attempts + "次");
  console.log("  - 测试耗时:", Math.round(testDuration / 1000) + "秒");
  
  // 分析重试时间间隔
  if (result.retryResults && result.retryResults.length > 1) {
    console.log("🕐 重试时间间隔分析:");
    for (let i = 1; i < result.retryResults.length; i++) {
      const prevTime = result.retryResults[i-1].timestamp;
      const currTime = result.retryResults[i].timestamp;
      const interval = Math.round((currTime - prevTime) / 1000);
      console.log(`  重试${i}: ${interval}秒间隔`);
      
      // 验证重试间隔是否符合预期（10秒 ± 2秒容错）
      test(`Retry ${i} interval should be around 10 seconds`, function() {
        expect(interval).to.be.within(8, 12);
      });
    }
  }
  
  // 验证重试次数
  test("Should attempt up to 3 retries", function() {
    expect(result.attempts).to.be.within(1, 3);
  });
  
  // 验证重试逻辑的正确性
  if (result.attempts === 3) {
    console.log("✅ 达到最大重试次数，符合预期");
    test("Should reach maximum retry attempts", function() {
      expect(result.attempts).to.equal(3);
    });
  } else if (result.success && result.attempts < 3) {
    console.log("✅ 在最大重试次数内成功，这是最佳情况");
    test("Should succeed before max attempts", function() {
      expect(result.success).to.be.true;
      expect(result.attempts).to.be.lessThan(3);
    });
  }
  
  // 保存重试测试结果
  bru.setVar("retryTestSuccess", result.success);
  bru.setVar("totalRetryAttempts", result.attempts);
  bru.setVar("retryLogicWorking", result.attempts >= 1);
  
  // 计算重试效率
  const expectedMinDuration = (result.attempts - 1) * 10; // 重试间隔时间
  const actualDuration = Math.round(testDuration / 1000);
  const efficiency = expectedMinDuration > 0 ? (expectedMinDuration / actualDuration) * 100 : 100;
  
  console.log("📈 重试效率分析:");
  console.log("  - 期望最小时长:", expectedMinDuration + "秒");
  console.log("  - 实际执行时长:", actualDuration + "秒");
  console.log("  - 执行效率:", Math.round(efficiency) + "%");
  
  // 分析每次重试的详细信息
  if (result.retryResults && result.retryResults.length > 0) {
    console.log("🔍 重试详细信息:");
    result.retryResults.forEach((retry, index) => {
      const retryTime = new Date(retry.timestamp).toLocaleTimeString();
      const delay = retry.delay ? `(延迟${retry.delay/1000}秒)` : '';
      console.log(`  第${index + 1}次: ${retryTime} ${delay}`);
      if (retry.detail && retry.detail.error) {
        console.log(`    错误: ${retry.detail.error}`);
      }
    });
  }
  
  // 下一步建议
  if (result.attempts === 3 && !result.success) {
    console.log("💡 建议: 重试逻辑正常工作，可以测试认证弹窗触发");
  } else if (result.success) {
    console.log("💡 建议: 重试成功，系统恢复正常");
  } else {
    console.log("💡 建议: 检查重试逻辑配置或网络状况");
  }
}

docs {
  # 重试逻辑测试

  ## 🎯 测试目的
  验证token刷新失败时的重试机制是否按照设计要求工作：
  - 失败后延迟10秒重试
  - 最多重试3次
  - 重试间隔时间准确

  ## 📋 测试场景
  1. **强制失败场景** - 模拟refresh token过期，确保刷新失败
  2. **观察现有重试** - 如果系统已经在重试，观察重试行为
  3. **混合场景** - 部分失败，部分成功

  ## 🔍 验证点
  1. ✅ 重试次数符合预期（最多3次）
  2. ✅ 重试间隔准确（10秒 ± 2秒容错）
  3. ✅ 重试逻辑能够正确触发
  4. ✅ 达到最大次数后停止重试

  ## 📊 性能指标
  - **重试间隔准确性** - 实际间隔与期望间隔的匹配度
  - **执行效率** - 实际耗时与理论最小耗时的比率
  - **重试成功率** - 在最大次数内成功的概率

  ## 🕐 时间计算
  - 理论最小时长 = (重试次数 - 1) × 10秒
  - 实际执行时长包括网络延迟和处理时间
  - 效率 = 理论时长 / 实际时长 × 100%

  ## 🔄 智能测试策略
  根据前一个测试的结果调整测试方法：
  - 如果前次刷新成功 → 强制模拟失败
  - 如果前次有失败 → 观察现有重试逻辑
  - 根据系统状态动态调整测试参数
}
