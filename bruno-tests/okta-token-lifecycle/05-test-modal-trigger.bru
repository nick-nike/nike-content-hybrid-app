meta {
  name: 05 - Test Modal Trigger
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/token/test-modal
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "triggerCondition": "max_retries_exceeded",
    "timeoutSeconds": 30,
    "expectedModal": "auth_expired"
  }
}

vars:pre-request {
  modalTestStartTime: {{$timestamp}}
}

script:pre-request {
  bru.setVar("modalTestStartTime", Date.now());
  
  console.log("🚨 开始测试认证弹窗触发");
  console.log("📋 测试参数:");
  console.log("  - 触发条件: 达到最大重试次数");
  console.log("  - 超时时间: 30秒");
  console.log("  - 期望弹窗: 认证过期弹窗");
  
  // 根据前面测试的结果调整策略
  const retryLogicWorking = bru.getVar("retryLogicWorking");
  const totalRetryAttempts = bru.getVar("totalRetryAttempts") || 0;
  
  if (retryLogicWorking && totalRetryAttempts >= 3) {
    console.log("✅ 检测到重试逻辑已达到最大次数，弹窗应该会被触发");
  } else if (totalRetryAttempts < 3) {
    console.log("🔄 重试次数未达到最大值，将强制触发弹窗条件");
    req.setBody(JSON.stringify({
      triggerCondition: "force_modal",
      timeoutSeconds: 20,
      expectedModal: "auth_expired"
    }));
  }
}

script:post-response {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response should have modal test results", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('modalShown');
    expect(body).to.have.property('triggerTime');
  });
  
  const result = res.getBody();
  const testDuration = Date.now() - bru.getVar("modalTestStartTime");
  
  console.log("📊 认证弹窗测试结果:");
  console.log("  - 测试成功:", result.success ? "✅ 是" : "❌ 否");
  console.log("  - 弹窗显示:", result.modalShown ? "✅ 是" : "❌ 否");
  console.log("  - 触发时间:", result.triggerTime ? Math.round(result.triggerTime) + "ms" : "未触发");
  console.log("  - 测试耗时:", Math.round(testDuration / 1000) + "秒");
  
  // 验证弹窗触发
  if (result.modalShown) {
    test("Modal should be triggered successfully", function() {
      expect(result.modalShown).to.be.true;
      expect(result.success).to.be.true;
    });
    
    // 验证触发时间合理性
    test("Modal trigger time should be reasonable", function() {
      expect(result.triggerTime).to.be.lessThan(30000); // 30秒内
      expect(result.triggerTime).to.be.greaterThan(100);  // 至少100ms
    });
    
    console.log("✅ 弹窗触发验证通过");
    
    // 分析触发性能
    const triggerSeconds = Math.round(result.triggerTime / 1000 * 10) / 10;
    console.log("📈 弹窗性能分析:");
    console.log("  - 触发响应时间:", triggerSeconds + "秒");
    
    if (triggerSeconds < 5) {
      console.log("  - 性能评级: 🚀 优秀 (< 5秒)");
    } else if (triggerSeconds < 15) {
      console.log("  - 性能评级: ✅ 良好 (5-15秒)");
    } else {
      console.log("  - 性能评级: ⚠️ 一般 (> 15秒)");
    }
    
  } else {
    console.log("❌ 弹窗未触发");
    
    test("Should investigate why modal was not triggered", function() {
      // 弹窗未触发可能的原因：
      // 1. 触发条件未满足
      // 2. 弹窗被其他逻辑阻止
      // 3. 系统配置问题
      if (result.error) {
        console.log("错误信息:", result.error);
      }
      // 这里我们记录但不强制失败，因为可能有合理的原因
    });
  }
  
  // 分析弹窗内容和行为
  if (result.modalDetails) {
    console.log("🔍 弹窗详细信息:");
    console.log("  - 弹窗类型:", result.modalDetails.type || "未知");
    console.log("  - 弹窗标题:", result.modalDetails.title || "未知");
    console.log("  - 操作按钮:", result.modalDetails.actions || "未知");
    
    // 验证弹窗内容
    test("Modal should have appropriate content", function() {
      expect(result.modalDetails).to.have.property('type');
      expect(result.modalDetails.type).to.include('auth');
    });
  }
  
  // 保存测试结果
  bru.setVar("modalTestSuccess", result.success);
  bru.setVar("modalShown", result.modalShown);
  bru.setVar("modalTriggerTime", result.triggerTime);
  
  // 测试用户交互选项
  if (result.modalShown && result.modalDetails && result.modalDetails.actions) {
    console.log("🎛️ 可用的用户操作:");
    result.modalDetails.actions.forEach((action, index) => {
      console.log(`  ${index + 1}. ${action.text || action.type}`);
    });
  }
  
  // 下一步建议
  if (result.modalShown) {
    console.log("💡 建议: 弹窗触发正常，可以测试用户交互和恢复流程");
  } else {
    console.log("💡 建议: 检查弹窗触发条件和系统配置");
  }
  
  // 完整流程总结
  console.log("\n📋 完整测试流程总结:");
  console.log("1. Token状态检查:", bru.getVar("isExpired") ? "❌ 已过期" : "✅ 有效");
  console.log("2. 过期时间模拟:", bru.getVar("simulatedMinutes") + "分钟");
  console.log("3. 自动刷新测试:", bru.getVar("refreshTestSuccess") ? "✅ 成功" : "❌ 失败");
  console.log("4. 重试逻辑测试:", bru.getVar("totalRetryAttempts") + "次重试");
  console.log("5. 弹窗触发测试:", result.modalShown ? "✅ 触发" : "❌ 未触发");
}

docs {
  # 认证弹窗触发测试

  ## 🎯 测试目的
  验证在所有重试失败后，系统是否能正确触发重新授权弹窗。

  ## 📋 触发条件
  1. **max_retries_exceeded** - 达到最大重试次数（3次）
  2. **token_permanently_expired** - Token完全过期且无法刷新
  3. **force_modal** - 强制触发（用于测试）
  4. **user_inactive** - 用户长时间无活动

  ## 🔍 验证点
  1. ✅ 弹窗能够被正确触发
  2. ✅ 触发时间在合理范围内（< 30秒）
  3. ✅ 弹窗内容和操作按钮正确
  4. ✅ 弹窗类型符合预期（认证过期）

  ## 📊 性能评级标准
  - 🚀 **优秀** (< 5秒) - 用户几乎无感知延迟
  - ✅ **良好** (5-15秒) - 可接受的响应时间
  - ⚠️ **一般** (> 15秒) - 用户可能感到等待

  ## 🎛️ 用户交互选项
  弹窗应该提供的操作：
  - **重新登录** - 跳转到Okta登录页面
  - **刷新会话** - 尝试使用refresh token
  - **稍后提醒** - 延迟弹窗显示
  - **关闭应用** - 安全退出

  ## 🔄 智能测试策略
  根据前面测试的结果调整触发条件：
  - 如果重试已达到最大次数 → 测试自然触发
  - 如果重试未完成 → 强制触发测试
  - 根据token状态选择合适的触发方式

  ## 📈 测试数据收集
  - 弹窗触发响应时间
  - 弹窗内容完整性
  - 用户操作可用性
  - 与前序测试的关联分析
}
